APP_NAME="I-NNOVA POS"
APP_TITLE=
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=error
APP_URL=http://localhost
APP_LOCALE=en
APP_TIMEZONE=Africa/Douala

# Usernames with superadmin rights (comma-separated). php artisan innova:install sets it.
ADMINISTRATOR_USERNAMES=
# Public sign-up of new businesses: off on a client's installation
ALLOW_REGISTRATION=false
ENABLE_GST_REPORT_INDIA=false
SHOW_REPAIR_STATUS_LOGIN_SCREEN=false

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=innova_pos
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
